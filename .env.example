# AI Fikir Çekirdeği (bkz. src/lib/idea-core-ai.ts)
#
# Tanımlı değilse, veya model çağrısı başarısız olursa, sistem otomatik olarak
# deterministik fallbackPlan'a geçer — anahtar olmadan da uygulama tam olarak
# çalışır (bkz. README > Sonraki Adımlar / Sprint 4).
GOOGLE_GENERATIVE_AI_API_KEY=

# İsteğe bağlı: varsayılan gemini-3.6-flash yerine farklı bir model kullan.
# (gemini-2.5-flash Google tarafından yeni kullanıcılara kapatıldı; teknik
# rapordaki google/gemini-3.7-flash tahmini haklı çıktı — Gemini 3.x güncel
# nesil, API'nin önerdiği tam sürüm gemini-3.6-flash.)
MEYDAN_GEMINI_MODEL=

# Katkı/onay akışı ve kalıcı Katkı Puanı (KP) defteri (bkz. src/lib/ideas-db.ts).
#
# Vercel'de proje panelinden bir Postgres (Neon) storage eklediğinizde
# POSTGRES_URL otomatik olarak enjekte edilir — bu durumda bu değişkeni elle
# doldurmanıza gerek yoktur. Yerel geliştirmede kendi Postgres'inizin bağlantı
# dizesini DATABASE_URL olarak girin (ör. yerel bir Docker Postgres).
#
# Tanımlı değilse "Fikirler & Katkılar" paneli anlaşılır bir hata gösterir;
# 3B dünya ve AI Fikir Çekirdeği'nin geri kalanı bundan etkilenmez.
DATABASE_URL=

# Gerçek zamanlı senkronizasyon (bkz. src/lib/pusher-server.ts, IdeasBrowser.tsx).
#
# Pusher Channels (ücretsiz katman) üzerinden: bir fikir/katkı değiştiğinde
# tüm açık istemcilere anında bildirim gider, periyodik yenilemeyi beklemeden.
# Tanımlı değilse sessizce devre dışı kalır ve istemci daha uzun aralıklı bir
# yedek yenilemeye (60sn) döner — gerçek zamanlı özellik olmadan da uygulama
# çalışır.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
# İstemci tarafında da aynı KEY/CLUSTER'a ihtiyaç var (secret hariç — o asla
# tarayıcıya gönderilmez). Vite yalnızca VITE_ önekli değişkenleri client
# bundle'a gömer, bu yüzden aynı değerler burada tekrarlanır.
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=
